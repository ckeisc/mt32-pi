+    else
 #endif
+    {
+        uint8_t operand = MCU_ReadCodeAdvance(mcu);
+        MCU_Operand_Table[operand](mcu, operand);
+    }
 
     if (mcu.sr & STATUS_T)
     {
@@ -904,8 +931,13 @@ void MCU_Step(mcu_t& mcu)
         mcu.ex_ignore = 0;
 
     if (!mcu.sleep)
