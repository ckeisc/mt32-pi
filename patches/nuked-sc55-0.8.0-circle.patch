@@ -0,0 +1,61 @@
+// H8 JIT dynamic recompiler.
+//
+// Third execution engine beside decoder2 and the legacy interpreter,
+// selected via MCU_SetH8Engine(H8Engine::JIT). Translation is per
+// guest instruction (one native codelet per instruction), so the
+// step/peripheral interleaving matches the interpreters exactly.
+// Translation input is decoder2's own disassembler; any form the
+// translator does not implement executes through decoder2 (the
+// oracle). Codelets are cached by guest address and invalidated when
+// guest code memory is written.
+//
+// The code arena lives in section .text.jit_arena: Circle's linker
+// script folds it into .text (below _etext, which Circle maps
+// readable/writable/executable), and hosted builds fold it into the
+// executable segment (made writable once via mprotect on Linux).
+// Code must never execute from the malloc heap, which Circle maps
+// execute-never.
+//
+// Part of the mt32-pi Circle patch set for Nuked-SC55 (GPLv2+,
+// matching upstream).
+
+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+
+struct mcu_t;
+
+// Execute one guest instruction under the JIT engine (called from
+// MCU_ReadInstruction in place of the interpreter dispatch).
+void JIT_Execute(mcu_t& mcu);
+
+// Drop all translated blocks. Called on engine switches, guest
+// resets, and state restores (snapshots), where cached blocks may no
+// longer match guest memory.
+void JIT_Flush();
+
+// Notify the JIT of a guest memory write; blocks overlapping the
+// written page are invalidated (guest RAM is executable on this MCU).
+void JIT_NotifyWrite(uint32_t address);
+
+struct JITStats
+{
+    uint64_t nBlocksCreated  = 0; // native cache entries created (fallback lives in a bitmap)
+    uint64_t nBlockHits      = 0; // executions served from the cache
+    uint64_t nNativeSteps    = 0; // guest instructions executed as native code
+    uint64_t nCodelets       = 0; // native codelets emitted
+    uint64_t nFallbackSteps  = 0; // guest instructions delegated to decoder2
+    uint64_t nTranslateFails = 0; // forms left as fallback (unimplemented/unknown)
+    uint64_t nDedupeHits     = 0; // translations served by an identical existing codelet
+    uint64_t nInvalidations  = 0; // cache entries dropped by code-memory writes
+    uint64_t nFlushes        = 0; // full cache flushes (engine switch, state restore)
+    uint64_t nReclaims       = 0; // arena reuses (fallback entries survive these)
+    uint64_t nArenaBytesUsed = 0; // high-water mark of emitted code
+};
+
+const JITStats& JIT_GetStats();
+
+// Base/size of the reserved native-code arena (diagnostics).
+const uint8_t* JIT_ArenaBase();
+size_t         JIT_ArenaSize();
