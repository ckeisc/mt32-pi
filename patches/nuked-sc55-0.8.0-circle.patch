+#if defined(__aarch64__)
+// Vector calc_tv across 4 voices for one fixed envelope index e.
+// Bit-identical to scalar calc_tv by construction: every gated update uses
+// a select (vbsl), never a zero-substituted add; all shifts are arithmetic
+// (NEON SSHL with negative counts), matching GCC's codegen for the scalar
+// signed shifts. tv_counter and nfs are uniform across lanes (tick
+// invariants); e is uniform per call. active_mask lanes are all-ones for
+// an active voice, zero otherwise.
+static inline void calc_tv_vec4(pcm_t& pcm, int e,
+                                int32x4_t adjust, int32x4_t levelcur_in,
+                                uint32x4_t active_mask,
+                                int32x4_t* levelcur_out, int32x4_t* volmul_out)
+{
+    const int32x4_t zero = vdupq_n_s32(0);
+    const int32x4_t one = vdupq_n_s32(1);
+    const uint32x4_t allones = vdupq_n_u32(0xFFFFFFFF);
+    int32x4_t lc = vandq_s32(levelcur_in, vdupq_n_s32(0x7fff));
+    int32x4_t speed = vandq_s32(adjust, vdupq_n_s32(0xff));
+    int32x4_t target = vandq_s32(vshrq_n_s32(adjust, 8), vdupq_n_s32(0xff));
+
+    // Masks (all-ones = true) and 0/1 versions of the w-conditions.
+    uint32x4_t w1m = vceqzq_u32(vreinterpretq_u32_s32(vandq_s32(speed, vdupq_n_s32(0xf0))));
+    uint32x4_t w2m = vorrq_u32(w1m, vmvnq_u32(vceqzq_u32(vreinterpretq_u32_s32(vandq_s32(speed, vdupq_n_s32(0x10))))));
+    uint32x4_t s80m = vceqzq_u32(vreinterpretq_u32_s32(vandq_s32(speed, vdupq_n_s32(0x80))));
+    uint32x4_t s40m = vceqzq_u32(vreinterpretq_u32_s32(vandq_s32(speed, vdupq_n_s32(0x40))));
+    uint32x4_t s20m = vceqzq_u32(vreinterpretq_u32_s32(vandq_s32(speed, vdupq_n_s32(0x20))));
+    uint32x4_t w3m = vdupq_n_u32(0);
+    if (pcm.nfs)
+        w3m = vorrq_u32(s80m, vandq_u32(s40m, vorrq_u32(vmvnq_u32(w2m), s20m)));
+    int32x4_t w2_01 = vandq_s32(vreinterpretq_s32_u32(w2m), one);
+    int32x4_t w3_01 = vandq_s32(vreinterpretq_s32_u32(w3m), one);
+    int32x4_t type = vorrq_s32(w2_01, vshlq_n_s32(w3_01, 3));
+    type = vorrq_s32(type, vandq_s32(vreinterpretq_s32_u32(vmvnq_u32(s20m)), vdupq_n_s32(2)));
+    type = vorrq_s32(type, vandq_s32(vreinterpretq_s32_u32(vorrq_u32(s80m, s40m)), vdupq_n_s32(4)));
+
+    uint32x4_t t4m = vmvnq_u32(vceqzq_u32(vreinterpretq_u32_s32(vandq_s32(type, vdupq_n_s32(4)))));
+    uint32x4_t t8m = vmvnq_u32(vceqzq_u32(vreinterpretq_u32_s32(vandq_s32(type, vdupq_n_s32(8)))));
+    int32x4_t type3 = vandq_s32(type, vdupq_n_s32(3));
+    uint32x4_t c0m = vceqzq_u32(vreinterpretq_u32_s32(type3));
+    uint32x4_t c1m = vceqzq_u32(vreinterpretq_u32_s32(vsubq_s32(type3, one)));
+    uint32x4_t c2m = vceqzq_u32(vreinterpretq_u32_s32(vsubq_s32(type3, vdupq_n_s32(2))));
+    // c3 is the fallthrough; no mask needed (select chain default).
+
+    // addlow candidates: tv_counter is uniform, so each is a scalar.
+    const int tvc = pcm.tv_counter;
+    const int addlow4 = ((tvc & 8) ? 1 : 0) | ((tvc & 4) ? 2 : 0) | ((tvc & 2) ? 4 : 0) | ((tvc & 1) ? 8 : 0);
+    const int addlow0 = ((tvc & 0x20) ? 1 : 0) | ((tvc & 0x10) ? 2 : 0) | ((tvc & 8) ? 4 : 0) | ((tvc & 4) ? 8 : 0);
+    const int addlow1 = ((tvc & 0x80) ? 1 : 0) | ((tvc & 0x40) ? 2 : 0) | ((tvc & 0x20) ? 4 : 0) | ((tvc & 0x10) ? 8 : 0);
+    const int addlow2 = ((tvc & 0x200) ? 1 : 0) | ((tvc & 0x100) ? 2 : 0) | ((tvc & 0x80) ? 4 : 0) | ((tvc & 0x40) ? 8 : 0);
+    const int addlow3 = ((tvc & 0x800) ? 1 : 0) | ((tvc & 0x400) ? 2 : 0) | ((tvc & 0x200) ? 4 : 0) | ((tvc & 0x100) ? 8 : 0);
+    int32x4_t addlow = vbslq_s32(t4m, vdupq_n_s32(addlow4),
+                         vbslq_s32(c0m, vdupq_n_s32(addlow0),
+                         vbslq_s32(c1m, vdupq_n_s32(addlow1),
+                         vbslq_s32(c2m, vdupq_n_s32(addlow2), vdupq_n_s32(addlow3)))));
+
+    // write = !active | (type&4) | case condition (scalar per case).
+    const int cond0 = ((tvc & 3) == 0) ? 1 : 0;
+    const int cond1 = ((tvc & 15) == 0) ? 1 : 0;
+    const int cond2 = ((tvc & 63) == 0) ? 1 : 0;
+    const int cond3 = ((tvc & 127) == 0) ? 1 : 0;
+    int32x4_t write01 = vandq_s32(vreinterpretq_s32_u32(vceqzq_u32(active_mask)), one);
+    write01 = vorrq_s32(write01, vandq_s32(vreinterpretq_s32_u32(t4m), one));
+    write01 = vorrq_s32(write01, vbslq_s32(t4m, zero,
+                            vbslq_s32(c0m, vdupq_n_s32(cond0),
+                            vbslq_s32(c1m, vdupq_n_s32(cond1),
+                            vbslq_s32(c2m, vdupq_n_s32(cond2), vdupq_n_s32(cond3))))));
+    uint32x4_t wmask = pcm.nfs ? vreinterpretq_u32_s32(vnegq_s32(write01)) : vdupq_n_u32(0);
+
+    int32x4_t lc4 = vshlq_n_s32(lc, 4);
+    int32x4_t sub = (e != 2) ? lc4 : vbslq_s32(active_mask, lc4, zero);
+    int32x4_t tgt11 = vshlq_n_s32(target, 11);
+
+    // Branch A: (type & 8) == 0.
+    int32x4_t shiftA = vandq_s32(vsubq_s32(vdupq_n_s32(10), vandq_s32(speed, vdupq_n_s32(15))), vdupq_n_s32(15));
+    int32x4_t sum1A = vsubq_s32(tgt11, sub);
+    int32x4_t shiftedA = vsubq_s32(vshlq_s32(sum1A, vnegq_s32(shiftA)), sum1A);
+    int32x4_t sum2A = vaddq_s32(vaddq_s32(tgt11, addlow), shiftedA);
+    int32x4_t lcA = vbslq_s32(wmask, vandq_s32(vshrq_n_s32(sum2A, 4), vdupq_n_s32(0x7fff)), lc);
+    int32x4_t volA = vandq_s32(vshrq_n_s32(sum2A, 4), vdupq_n_s32(0x7ffe));
+
+    // Branch B: (type & 8) != 0.
+    int32x4_t shiftB = vandq_s32(vsubq_s32(vdupq_n_s32(10), vorrq_s32(vandq_s32(vshrq_n_s32(speed, 4), vdupq_n_s32(14)), w2_01)), vdupq_n_s32(15));
+    int32x4_t sum1B = vsubq_s32(tgt11, sub);
+    uint32x4_t negm = vmvnq_u32(vceqzq_u32(vreinterpretq_u32_s32(vandq_s32(sum1B, vdupq_n_s32(0x80000)))));
+    int32x4_t preshift = vshlq_n_s32(vandq_s32(speed, vdupq_n_s32(15)), 9);
+    preshift = vorrq_s32(preshift, vbslq_s32(vmvnq_u32(w1m), vdupq_n_s32(0x2000), zero));
+    preshift = veorq_s32(preshift, vbslq_s32(negm, vdupq_n_s32(-64), zero));
+    int32x4_t shiftedB = vshlq_s32(preshift, vnegq_s32(shiftB));
+    int32x4_t addterm = (e != 2) ? vorrq_s32(lc4, addlow) : vbslq_s32(active_mask, vorrq_s32(lc4, addlow), zero);
+    int32x4_t sum2B = vaddq_s32(shiftedB, addterm);
+    int32x4_t sum2_lB = vshrq_n_s32(sum2B, 4);
+    int32x4_t sum3B = vsubq_s32(tgt11, vshlq_n_s32(sum2_lB, 4));
+    uint32x4_t neg2m = vmvnq_u32(vceqzq_u32(vreinterpretq_u32_s32(vandq_s32(sum3B, vdupq_n_s32(0x80000)))));
+    uint32x4_t xnorm = vmvnq_u32(veorq_u32(neg2m, negm));
+    int32x4_t lcB = vbslq_s32(wmask, vbslq_s32(xnorm, vandq_s32(sum2_lB, vdupq_n_s32(0x7fff)), vshlq_n_s32(target, 7)), lc);
+    int32x4_t volB;
+    if (e == 0)
+        volB = vandq_s32(sum2_lB, vdupq_n_s32(0x7ffe));
+    else if (e == 1)
+        volB = vbslq_s32(xnorm, vandq_s32(sum2_lB, vdupq_n_s32(0x7ffe)), vshlq_n_s32(target, 7));
+    else
+        volB = zero;
+
+    *levelcur_out = vbslq_s32(t8m, lcB, lcA);
+    *volmul_out = vbslq_s32(t8m, volB, volA);
+    (void)allones;
+}
+#endif // __aarch64__
+
+#if defined(__aarch64__)
+static inline int32x4_t neon_sx20(int32x4_t x) { return vshrq_n_s32(vshlq_n_s32(x, 12), 12); }
+static inline int32x4_t neon_sx8(int32x4_t x) { return vshrq_n_s32(vshlq_n_s32(x, 24), 24); }
+static inline int32x4_t neon_multi(int32x4_t a, int32x4_t b) { return vmulq_s32(neon_sx20(a), b); }
+static inline int32x4_t neon_addclip20(int32x4_t a, int32x4_t b, int32x4_t cin)
+{
+    return vaddq_s32(vaddq_s32(neon_sx20(a), neon_sx20(b)), cin);
+}
+
+// Vector interpolation for 4 voices. nibmask lanes hold bits cmp2=1,
+// cmp3=2, cmp4=4. lut is interp_lut (int [3][128]).
+static inline int32x4_t neon_interp_vec4(int32x4_t samp0, int32x4_t samp1, int32x4_t samp2,
+                                         int32x4_t ratio, int32x4_t nibmask,
+                                         int32x4_t oldnib, int32x4_t newnib,
+                                         int32x4_t test_in, const int (*lut)[128])
+{
+    const int32x4_t one = vdupq_n_s32(1);
+    int r[4], nm[4];
+    vst1q_s32(r, ratio);
+    vst1q_s32(nm, nibmask);
+    int32x4_t test = test_in;
+    int32x4_t samps[3] = { samp0, samp1, samp2 };
+    const int bits[3] = { 1, 2, 4 };
+    for (int k = 0; k < 3; k++)
+    {
+        int lk[4] = { lut[k][r[0]], lut[k][r[1]], lut[k][r[2]], lut[k][r[3]] };
+        int32x4_t L = vld1q_s32(lk);
+        int32x4_t step = vshrq_n_s32(neon_multi(vshlq_n_s32(L, 6), samps[k]), 8);
+        uint32x4_t cm = vmvnq_u32(vceqzq_u32(vreinterpretq_u32_s32(vandq_s32(nibmask, vdupq_n_s32(bits[k])))));
+        int32x4_t sel = vbslq_s32(cm, oldnib, newnib);
+        int32x4_t shift = vandq_s32(vsubq_s32(vdupq_n_s32(10), sel), vdupq_n_s32(15));
+        step = vshlq_s32(vshlq_n_s32(step, 1), vnegq_s32(shift));
+        test = neon_addclip20(test, vshrq_n_s32(step, 1), vandq_s32(step, one));
+    }
+    (void)nm;
+    return test;
+}
+
+static inline void neon_filter_mk1_vec4(int32x4_t test, int32x4_t reg1, int32x4_t reg3,
+                                        int32x4_t filt, int32x4_t reg26,
+                                        int32x4_t* v1out, int32x4_t* v5out, int32x4_t* v3out)
+{
+    const int32x4_t one = vdupq_n_s32(1);
+    int32x4_t fhi = neon_sx8(vshrq_n_s32(filt, 8));
+    int32x4_t fmid = vandq_s32(vshrq_n_s32(filt, 1), vdupq_n_s32(127));
+    int32x4_t m1 = neon_multi(reg1, fhi);
+    int32x4_t m2 = neon_multi(reg1, fmid);
+    int32x4_t m3 = neon_multi(reg1, reg26);
+    int32x4_t v2 = neon_addclip20(reg3, vshrq_n_s32(m1, 6), vandq_s32(vshrq_n_s32(m1, 5), one));
+    int32x4_t v1 = neon_addclip20(v2, vshrq_n_s32(m2, 13), vandq_s32(vshrq_n_s32(m2, 12), one));
+    int32x4_t sub = neon_addclip20(v1, vshrq_n_s32(m3, 6), vandq_s32(vshrq_n_s32(m3, 5), one));
+    int32x4_t v3 = neon_addclip20(test, veorq_s32(sub, vdupq_n_s32(0xfffff)), one);
+    int32x4_t m4 = neon_multi(v3, fhi);
+    int32x4_t m5 = neon_multi(v3, fmid);
+    int32x4_t v4 = neon_addclip20(reg1, vshrq_n_s32(m4, 6), vandq_s32(vshrq_n_s32(m4, 5), one));
+    int32x4_t v5 = neon_addclip20(v4, vshrq_n_s32(m5, 13), vandq_s32(vshrq_n_s32(m5, 12), one));
+    *v1out = v1; *v5out = v5; *v3out = v3;
+}
+
+static inline void neon_filter_jv_vec4(int32x4_t test, int32x4_t reg1, int32x4_t reg3,
+                                       int32x4_t filt, int32x4_t reg26,
+                                       int32x4_t* v1out, int32x4_t* v5out, int32x4_t* v3out)
+{
+    const int32x4_t one = vdupq_n_s32(1);
+    int32x4_t fhi = neon_sx8(vshrq_n_s32(filt, 8));
+    int32x4_t fmid = vandq_s32(vshrq_n_s32(filt, 1), vdupq_n_s32(127));
+    int32x4_t m1 = vmulq_s32(reg1, fhi);
+    int32x4_t m2 = vmulq_s32(reg1, fmid);
+    int32x4_t m3 = vmulq_s32(reg1, reg26);
+    int32x4_t v2 = vaddq_s32(vaddq_s32(reg3, vshrq_n_s32(m1, 6)), vandq_s32(vshrq_n_s32(m1, 5), one));
+    int32x4_t v1 = vaddq_s32(vaddq_s32(v2, vshrq_n_s32(m2, 13)), vandq_s32(vshrq_n_s32(m2, 12), one));
+    int32x4_t sub = vaddq_s32(vaddq_s32(v1, vshrq_n_s32(m3, 6)), vandq_s32(vshrq_n_s32(m3, 5), one));
+    int32x4_t tests = vshrq_n_s32(vshlq_n_s32(test, 12), 12);
+    int32x4_t v3 = vsubq_s32(tests, sub);
+    int32x4_t m4 = vmulq_s32(v3, fhi);
