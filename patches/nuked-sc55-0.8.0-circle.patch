diff --git a/src/backend/split_thread_circle.h b/src/backend/split_thread_circle.h
new file mode 100644
index 0000000..ee9abaf
--- /dev/null
+++ b/src/backend/split_thread_circle.h
@@ -0,0 +1,348 @@
+/*
+ * mt32-pi dual-core Nuked-SC55 split: ROMACCLZ sync (trim + FIFO).
+ *
+ * One shared pcm_t, no shadows, no RPC, no lock. Core 2 (the audio
+ * core) steps the H8 MCU and RELEASE-publishes its cycle count every
+ * 8 steps; core 3 (the PCM core) renders bounded batches of at most
+ * 128 ticks, capped at published-800, and posts samples into the
+ * synth's sample ring. Core 2 drains that ring through the resampler.
+ *
+ * The coordination is trim's (cache-line padding, publish every 8
+ * steps, ring Avail every 16, IRQ0 via flag, 64-poll idle backoff)
+ * with the batch spinlock replaced by a deferred-store FIFO (the
+ * measured-best combination from the standalone kernel's friend2 run:
+ * core 2 413 cycles/step with zero lock spins, core 3 14,189
+ * cycles/tick, -11% vs base). Core 2 never blocks: each committing
+ * ram1/ram2 store is pushed as a (ram, channel, index, value) record
+ * into a single-producer single-consumer FIFO; core 3 applies all
+ * pending records at each tick boundary, in order, before rendering
+ * the tick. That is exactly the single-threaded emulator's semantics:
+ * in MCU_Step a register write always lands BEFORE the PCM_Update
+ * that follows the step, i.e. at a tick boundary, never mid-tick.
+ * Core 2's own latch reads consult the pending records first (newest
+ * wins), so read-your-own-write holds exactly as in the
+ * single-threaded engine; words core 3 mutates (envelopes, addresses)
+ * read live, as they did before. A FIFO that ever fills (4096 pending
+ * stores; the hardware run's high-water was 127) waits at most 20 ms
+ * and then drops the store rather than hanging core 2; any non-zero
+ * fifo_full_waits or fifo_drops invalidates the run.
+ *
+ * The state layout keeps the trim cache-line discipline: each writer
+ * group's fields sit on their own 64-byte lines, separated by 64-byte
+ * spacing (spacing, not base alignment, is what keeps two groups off
+ * one hardware line). There is deliberately no sev/wfe handling here:
+ * no wait-for-event exists on this path to lose a wakeup for.
+ */
+
+#ifndef _split_thread_circle_h
+#define _split_thread_circle_h
+
+#include <cstdint>
+
+#include <circle/timer.h>
+
+#include "mcu.h"
+#include "mcu_interrupt.h"
+#include "pcm.h"
+
+// Local cross-core barrier ("dmb ish": inner-shareable, the right
+// domain for visibility between cores of one SoC).
+static inline void SplitDMB()
+{
+    __asm__ volatile ("dmb ish" ::: "memory");
+}
+
+// Scheduler-free pause: ARM YIELD hint. Used inside lock spins and
+// the PCM task's idle backoff; the fork's task loop yields to the
+// scheduler separately when the PCM task has no work at all.
+static inline void SplitPause()
+{
+    __asm__ volatile ("yield" ::: "memory");
+}
+
+// Trim split state. See the file comment for the layout discipline.
+struct alignas(64) ThreadSplitStateCircle
+{
+
+    // ---- own line: core 2 -> core 3 published cycle count.
+    // Plain field, accessed ONLY via __atomic builtins cross-core:
+    // core 2 stores with RELEASE, core 3 loads with ACQUIRE.
+    alignas(64) uint64_t cycles_pub{0};
+
+    // ---- line: core-3-written, core-2-read ----
+    alignas(64) volatile uint64_t pcm_rendered{0};
+    volatile uint64_t pcm_task_us{0};
+    volatile uint64_t max_pcm_lag{0};
+    volatile uint64_t ticks{0};          // PCM ticks rendered (counted in DrainBeforeTick)
+    volatile uint64_t fifo_tail{0};      // FIFO consumer index (core 3)
+    // IRQ0 request flag: core 3 sets 1 (RELEASE) when a voice-end IRQ
+    // is asserted; core 2 folds it into interrupt_pending at the top
+    // of its next step.
+    volatile uint8_t  irq0_req{0};
+    // Core-3 progress marker for diagnostics: 0 parked, 1 idle poll,
+    // 2 about to render, 3 inside PCM_Update, 4 batch done.
+    volatile uint8_t  core3_phase{0};
+
+    // ---- line: core-2-written, core-2-read (diag snapshots) ----
+    alignas(64) volatile uint64_t publishes{0};       // cycles_pub RELEASE stores
+    volatile uint64_t irq0_folded{0};                 // IRQ0 flags folded by core 2
+    volatile uint64_t fifo_full_waits{0};             // FIFO pushes that had to wait for core 3 (must be 0)
+    volatile uint64_t fifo_hw{0};                     // FIFO depth high-water mark
+
+    // ---- line: FIFO producer index + core-2-private caches ----
+    alignas(64) volatile uint64_t fifo_head{0};       // FIFO producer index (core 2)
+    uint64_t fifo_tail_cache{0};                      // core-2 private copy of fifo_tail
+    volatile uint64_t fifo_drops{0};                  // stores dropped after a bounded full-wait (core 3 dead); must be 0
+
+    // Batch discipline: a tick is at most (31+1)*25 = 800 cycles, and
+    // a batch renders at most 128 ticks (the 128-sample bound).
+    static constexpr uint64_t MaxTickCycles = 800;
+    static constexpr uint64_t MaxBatchTicks = 128;
+
+    // Deferred-store FIFO: 4096 records, power of two. Written by
+    // core 2, read by core 3, on its own cache lines.
+    static constexpr uint32_t SplitFifoSize = 4096;
+    static constexpr uint32_t SplitFifoMask = SplitFifoSize - 1;
+    alignas(64) PCMDeferredStore fifo[SplitFifoSize]{};
+
+    // Apply every pending deferred store, core 3, tick boundary. One
+    // ACQUIRE load of the producer index per tick in the common
+    // (empty) case.
+    void FifoDrain(pcm_t& pcm)
+    {
+        uint64_t nTail = fifo_tail;
+        const uint64_t nHead = __atomic_load_n(&fifo_head, __ATOMIC_ACQUIRE);
+        if (nHead == nTail)
+            return;
+        while (nTail != nHead)
+        {
+            const PCMDeferredStore& st = fifo[nTail & SplitFifoMask];
+            if (st.is_ram2)
+                pcm.ram2[st.channel][st.index] = static_cast<uint16_t>(st.value);
+            else
+                pcm.ram1[st.channel][st.index] = st.value;
+            ++nTail;
+        }
+        __atomic_store_n(&fifo_tail, nTail, __ATOMIC_RELEASE);
+    }
+
+    // Push one deferred store (core 2). If the FIFO is full (4096
+    // pending stores -- core 3 drains every tick, so this only happens
+    // when core 3 has stopped) it waits for core 3 for at most 20 ms
+    // and counts the wait; if core 3 is still not draining, the store
+    // is DROPPED and counted (fifo_drops) rather than hanging core 2
+    // forever. Any non-zero fifo_drops invalidates the run.
+    void FifoPush(const PCMDeferredStore& st)
+    {
+        const uint64_t nHead = fifo_head;
+        if (nHead - fifo_tail_cache >= SplitFifoSize)
+        {
+            fifo_tail_cache = __atomic_load_n(&fifo_tail, __ATOMIC_ACQUIRE);
+            if (nHead - fifo_tail_cache >= SplitFifoSize)
+            {
+                fifo_full_waits = fifo_full_waits + 1;
+                const uint64_t t0 = CTimer::Get()->GetClockTicks();
+                do
+                {
+                    SplitPause();
+                    fifo_tail_cache = __atomic_load_n(&fifo_tail, __ATOMIC_ACQUIRE);
+                    if (CTimer::Get()->GetClockTicks() - t0 >= 20000ULL)
+                    {
+                        fifo_drops = fifo_drops + 1;
+                        return;
+                    }
+                } while (nHead - fifo_tail_cache >= SplitFifoSize);
+            }
+        }
+        fifo[nHead & SplitFifoMask] = st;
+        __atomic_store_n(&fifo_head, nHead + 1, __ATOMIC_RELEASE);
+        const uint64_t nDepth = nHead + 1 - fifo_tail_cache;
+        if (nDepth > fifo_hw)
+            fifo_hw = nDepth;
+    }
+
+    // Core-2 read-your-own-write overlay: the newest pending store to
+    // (ram, channel, index), if any. Scans newest to oldest; the FIFO
+    // is usually empty or a few records deep.
+    bool FifoLookup(bool bRam2, uint8_t nChannel, uint8_t nIndex, uint32_t* pValue)
+    {
+        const uint64_t nHead = fifo_head;
+        fifo_tail_cache = __atomic_load_n(&fifo_tail, __ATOMIC_ACQUIRE);
+        uint64_t n = nHead;
+        while (n != fifo_tail_cache)
+        {
+            --n;
+            const PCMDeferredStore& st = fifo[n & SplitFifoMask];
+            if ((st.is_ram2 != 0) == bRam2 && st.channel == nChannel && st.index == nIndex)
+            {
+                *pValue = st.value;
+                return true;
+            }
+        }
+        return false;
+    }
+
+    // Per-tick hook, called by PCM_Update at the top of each tick
+    // (core 3). Counts ticks and drains the FIFO at the tick boundary.
+    void DrainBeforeTick(pcm_t& pcm)
+    {
+        ticks = ticks + 1;
+        FifoDrain(pcm);
+    }
+
+    // (Re)initialise from live backend state. The caller guarantees
+    // core 3 is parked and the MCU thread is not stepping.
+    // Cumulative counters are deliberately NOT reset (the app
+    // snapshots them per window).
+    void InitFromPCM(pcm_t& pcm, mcu_t& mcu)
+    {
+        cycles_pub = (uint64_t)mcu.cycles;
+        pcm_rendered = pcm.cycles;
+        pcm_task_us = 0;
+        max_pcm_lag = 0;
+        ticks = 0;
+        irq0_req = 0;
+        fifo_head = 0;
+        fifo_tail = 0;
+        fifo_tail_cache = 0;
+        fifo_hw = 0;
+        core3_phase = 0;
+    }
+};
+
+// The split state instance. Defined by the synth (g_splitT in
+// nukedsc55synth.cpp); null whenever the split is inactive, in which
+// case the backend calls PCM_Read/PCM_Write directly.
+extern ThreadSplitStateCircle* g_splitT;
+
+// Core 3's voice-end IRQ assert. Called at the PCM_Update assert site
+// in place of the direct MCU_Interrupt_SetRequest(IRQ0, 1).
+// pcm.irq_assert / irq_channel are already set by the caller. When
+// the split is live (MK1 only), only the flag is set; core 2 folds it
+// into interrupt_pending at the top of its next step. Otherwise the
+// direct call (single-threaded path, or non-MK1) is preserved.
+inline void SplitAssertIrq0(pcm_t& pcm)
+{
+    if (g_splitT && pcm.mcu->is_mk1)
+        __atomic_store_n(&g_splitT->irq0_req, static_cast<uint8_t>(1), __ATOMIC_RELEASE);
+    else
+        MCU_Interrupt_SetRequest(*pcm.mcu, INTERRUPT_SOURCE_IRQ0, 1);
+}
+
+// Core 2: fold a pending IRQ0 request into interrupt_pending. Called
+// at the top of every step by the synth's split step loop (one
+// ACQUIRE byte load; the line is written by core 3 only on voice ends).
+inline void SplitFoldIrq0(ThreadSplitStateCircle& s, mcu_t& mcu)
+{
+    if (__atomic_load_n(&s.irq0_req, __ATOMIC_ACQUIRE) != 0u)
+    {
+        __atomic_exchange_n(&s.irq0_req, static_cast<uint8_t>(0), __ATOMIC_ACQ_REL);
+        MCU_Interrupt_SetRequest(mcu, INTERRUPT_SOURCE_IRQ0, 1);
+        s.irq0_folded = s.irq0_folded + 1;
+    }
+}
+
+// MCU thread: register write into shared pcm state. Which writes
+// COMMIT a ram1/ram2 store is backend PCM_Write verbatim:
+// ram1 (0x04-0x10, 0x24-0x30) commits iff (addr&3)==3;
+// ram2 (0x10-0x20, 0x30-0x38) commits iff (addr&1)==1. Non-committing
+// bytes only touch core-2-private latch state and never synchronize.
+// A committing store is deferred: PCM_WriteDeferred computes the
+// record (every other effect applied as usual) and core 2 pushes it;
+// core 3 applies it at the next tick boundary. No lock anywhere.
+// Defensive fallback: if PCM_WriteDeferred ever reports no record for
+// a committing write (it cannot, by the verbatim commit test), the
+// store is written directly rather than dropped.
+inline void SkelPCMWrite(mcu_t& mcu, uint32_t addr, uint8_t value)
+{
+    addr &= 0x3f;
+    const bool bCommits =
+        ((((addr >= 0x04 && addr < 0x10) || (addr >= 0x24 && addr < 0x30)) && ((addr & 3) == 3)) ||
+         (((addr >= 0x10 && addr < 0x20) || (addr >= 0x30 && addr < 0x38)) && ((addr & 1) == 1)));
+    if (!bCommits)
+    {
+        PCM_Write(*mcu.pcm, addr, value);
+        return;
+    }
+    ThreadSplitStateCircle& s = *g_splitT;
+    PCMDeferredStore st{};
+    if (PCM_WriteDeferred(*mcu.pcm, addr, value, &st))
+        s.FifoPush(st);
+    else
+        PCM_Write(*mcu.pcm, addr, value);
+}
+
+// MCU thread: read from shared pcm state. Status reads (0x3c/0x3e,
+// including the IRQ-ack clear) run lock-free: the 0x3e ACK clears
+// irq_assert with an atomic exchange (core 3 sets it with a byte
+// store), and clears the interrupt request only if the flag was
+// actually set. Latch reads (PCM_Read's ram1/ram2 branches) see pending
+// stores first (read-your-own-write); index derivations are PCM_Read
+// verbatim. All other reads are direct.
+inline uint8_t SkelPCMRead(mcu_t& mcu, uint32_t addr)
+{
+    addr &= 0x3f;
+    ThreadSplitStateCircle& s = *g_splitT;
+    if (addr == 0x3c || addr == 0x3e)
+    {
+        pcm_t& pcm = *mcu.pcm;
+        uint8_t status = 0;
+        if (addr == 0x3e)
+        {
+            if (__atomic_exchange_n(&pcm.irq_assert, false, __ATOMIC_ACQ_REL))
+                MCU_Interrupt_SetRequest(mcu, INTERRUPT_SOURCE_IRQ0, 0);
+        }
+        status |= pcm.irq_channel;
+        if (pcm.voice_mask_updating)
+            status |= 32;
+        return status;
+    }
+    if (s.fifo_head != s.fifo_tail_cache)
+    {
+        pcm_t& pcm = *mcu.pcm;
+        if (((addr >= 0x4 && addr < 0x10) || (addr >= 0x24 && addr < 0x30)) && (addr & 3) == 1)
+        {
+            int ix = 0;
+            if (addr & 32) ix |= 1;
+            if ((addr & 8) == 0) ix |= 4;
+            if ((addr & 4) == 0) ix |= 2;
+            uint32_t v;
+            if (s.FifoLookup(false, pcm.select_channel, static_cast<uint8_t>(ix), &v))
+            {
+                pcm.read_latch = v;
+                return 0;
+            }
+        }
+        else if (((addr >= 0x10 && addr < 0x20) || (addr >= 0x30 && addr < 0x38)) && (addr & 1) == 0)
+        {
+            int ix = (addr >> 1) & 7;
+            if (addr & 32) ix |= 8;
+            uint32_t v;
+            if (s.FifoLookup(true, pcm.select_channel, static_cast<uint8_t>(ix), &v))
+            {
+                pcm.read_latch = static_cast<uint16_t>(v);
+                return 0;
+            }
+        }
+    }
+    return PCM_Read(*mcu.pcm, addr);
+}
+
+// Circle dispatch for the PCM call sites in mcu.cpp: FIFO split
+// (MK1 only) when the split is active, direct otherwise.
+inline void SplitPCMWrite(mcu_t& mcu, uint32_t addr, uint8_t value)
+{
+    if (g_splitT && mcu.is_mk1)
+        SkelPCMWrite(mcu, addr, value);
+    else
+        PCM_Write(*mcu.pcm, addr, value);
+}
+
+inline uint8_t SplitPCMRead(mcu_t& mcu, uint32_t addr)
+{
+    if (g_splitT && mcu.is_mk1)
+        return SkelPCMRead(mcu, addr);
+    return PCM_Read(*mcu.pcm, addr);
+}
+
+#endif
