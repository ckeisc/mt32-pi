+
+void Emulator::SetH8Engine(H8Engine engine)
+{
+    if (MCU_GetH8Engine() == engine)
+        return;
+
+    MCU_SetH8Engine(engine);
+
+#if NUKED_ENABLE_DECODER2
+    if (m_mcu)
+        m_mcu->icache.Reset();
+#endif
+}
+
+H8Engine Emulator::GetH8Engine() const
+{
+    return MCU_GetH8Engine();
+}
+
 void Emulator::Step()
 {
+    if (const auto pClock = NukedProfileClock())
+    {
+        const uint64_t nStart = pClock();
+        MCU_Step(*m_mcu);
+        NukedProfile().nTotalUs += pClock() - nStart;
+        return;
+    }
+
     MCU_Step(*m_mcu);
 }
 
