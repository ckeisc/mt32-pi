+// mt32-pi dual-core split (romacclz): one committed ram1/ram2 store,
+// produced by PCM_WriteDeferred instead of being applied, so the
+// PCM core can apply it at a tick boundary. value holds the full
+// write latch (ram1: 20 bits; ram2: low 16 bits).
+struct PCMDeferredStore
+{
+    uint8_t  is_ram2;
+    uint8_t  channel;
+    uint8_t  index;
+    uint8_t  pad;
+    uint32_t value;
+};
+// Exactly PCM_Write, except that a committing ram1/ram2 store is
