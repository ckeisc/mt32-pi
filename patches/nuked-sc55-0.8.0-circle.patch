+namespace
+{
+    NukedProfileClockFn g_nukedProfileClock = nullptr;
+    NukedProfileData g_nukedProfile;
+}
+
+void NukedProfileSetClock(NukedProfileClockFn pFn)
+{
+    g_nukedProfileClock = pFn;
+}
+
+NukedProfileClockFn NukedProfileClock()
+{
+    return g_nukedProfileClock;
+}
+
+NukedProfileData& NukedProfile()
+{
+    return g_nukedProfile;
+}
+
 void Emulator::Step()
 {
+    if (const auto pClock = NukedProfileClock())
+    {
+        const uint64_t nStart = pClock();
+        MCU_Step(*m_mcu);
+        NukedProfile().nTotalUs += pClock() - nStart;
+        return;
+    }
+
     MCU_Step(*m_mcu);
 }
 
