+// Full power-on reset for the split restart path. Reset() alone is
+// MCU_Reset + SM_Reset, which leaves the cycle counters at the old
+// song's end value (so the next song-end condition is immediately
+// true again) and leaves the firmware's SLEEP flag set (so the H8
+// never executes another instruction after a reset). Everything
+// below restores boot state; ROM images are kept. Must run while
+// core 3 is parked, never mid-batch.
+void Emulator::ResetForRestart()
+{
+    MCU_Reset(*m_mcu);   // registers, PC/CP from the reset vector, SR, device registers, timers
+    SM_Reset(*m_sm);
+    mcu_t& m = *m_mcu;
+    m.cycles            = 0;
+    m.sleep             = 0;
+    m.ex_ignore         = 0;
+    m.exception_pending = (MCU_Exception_Source)-1;
+    m.interrupt_pending = decltype(m.interrupt_pending){};
+    m.trapa_pending     = decltype(m.trapa_pending){};
+    m.uart_write_ptr    = 0;
+    m.uart_read_ptr     = 0;
+    m.uart_rx_byte      = 0;
+    m.uart_rx_delay     = 0;
+    m.uart_tx_delay     = 0;
+    for (bool& b : m.ga_int)
+        b = false;
+    m.ga_int_trigger    = 0;
+    m.ga_lcd_counter    = 0;
+    m.analog_end_time   = 0;
+    PCM_Reset(*m_pcm);
+}
