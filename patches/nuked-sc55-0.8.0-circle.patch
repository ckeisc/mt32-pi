--- a/src/backend/decoder2/cache.h
+++ b/src/backend/decoder2/cache.h
@@ -64,6 +64,17 @@ public:
 
     size_t CountCached() const;
 
+    // mt32-pi: drop all decoded instructions. Used when the H8
+    // execution path is switched at runtime, so decodes made under
+    // one path can never be consumed by the other. Cleared in place:
+    // this runs when the host heap may have only a few MB free, so it
+    // must never allocate.
+    void Reset()
+    {
+        if (m_cache)
+            m_cache->fill(DecodedInstruction{});
+    }
+
 private:
     std::unique_ptr<ArrayType> m_cache;
 };
