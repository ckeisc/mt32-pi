 if(NOT WIN32)
-    set(USE_RTMIDI TRUE)
-endif()
-
-if(USE_RTMIDI)
-    find_package(rtmidi MODULE REQUIRED)
+    # RtMidi is only needed by the standard frontend; do not require it.
+    # Cross/embedded builds that only build the backend library (e.g.
+    # mt32-pi) may not have it available. (Circle patch)
+    find_package(rtmidi MODULE)
+    if(RTMIDI_INCLUDE_DIR AND RTMIDI_LIBRARY AND NOT RTMIDI_INCLUDE_DIR MATCHES "NOTFOUND" AND NOT RTMIDI_LIBRARY MATCHES "NOTFOUND")
+        set(USE_RTMIDI TRUE)
+    endif()
 endif()
 
